# Local development can omit DATABASE_URL and use SQLite.
# For AWS RDS PostgreSQL, use a URL like:
# postgresql+psycopg://app_user:URL_ENCODED_PASSWORD@your-db.xxxxxx.region.rds.amazonaws.com:5432/daylight
DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/daylight
SECRET_KEY=replace-with-at-least-32-random-bytes
COOKIE_HTTPS_ONLY=true

# Optional. Without a key, the dashboard shows starter ideas and stays usable.
AI_API_KEY=
AI_MODEL=gpt-4o-mini